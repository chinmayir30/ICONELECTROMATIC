# Set to 'true' on local development to access the demo admin or live admin CMS
VITE_ENABLE_DEMO_ADMIN=false

# Supabase Configuration (placeholders only - real values go into git-ignored .env.local)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Static Site Rebuild Webhook URL (triggered when staff clicks 'Publish' in the Admin panel)
VITE_REBUILD_WEBHOOK_URL=
